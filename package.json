{
  "name": "festival-atlas",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/validate-data.mjs && node --test tests/*.test.mjs && next build && node scripts/smoke.mjs",
    "validate": "node scripts/validate-data.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.0",
    "@types/leaflet": "^1.9.12"
  }
}
